        <mxCell id="e2YKUBdYqAEWy2go2X0a-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;" value="Styles are the visual properties that define the view/control appearance." vertex="1">
