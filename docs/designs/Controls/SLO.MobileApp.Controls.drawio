        <mxCell id="e2YKUBdYqAEWy2go2X0a-6" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Base View/Controls&lt;/h1&gt;&lt;p&gt;Each Base View/Control will expose three main characteristics which are Properties, Capabilities, and Styles, this done in accordance to the Tri-Nature pattern as demonstrated by The Standards in the Theory Section under the 0.0.4 Fractal Theory.&lt;/p&gt;" vertex="1">
          <mxGeometry height="161" width="230" x="-232" y="123" as="geometry" />
        </mxCell>
