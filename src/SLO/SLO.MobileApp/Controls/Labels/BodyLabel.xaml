<?xml version="1.0" encoding="utf-8" ?>
<templatedViews:TemplatedLabelView
    x:Class="SLO.MobileApp.Controls.Labels.BodyLabel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bases="clr-namespace:SLO.MobileApp.Controls.Bases"
    xmlns:templatedViews="clr-namespace:SLO.MobileApp.Controls.TemplatedViews">

    <templatedViews:TemplatedLabelView.ControlTemplate>
        <ControlTemplate>

            <bases:LabelBase
                HorizontalTextAlignment="{TemplateBinding HorizontalTextAlignment}"
                Text="{TemplateBinding Text}"
                TextColor="{TemplateBinding TextColor}"
                VerticalTextAlignment="Center" />

        </ControlTemplate>
    </templatedViews:TemplatedLabelView.ControlTemplate>
</templatedViews:TemplatedLabelView>
