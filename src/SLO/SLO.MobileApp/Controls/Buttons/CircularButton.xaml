<?xml version="1.0" encoding="utf-8" ?>
<templatedViews:TemplatedButtonView
    x:Class="SLO.MobileApp.Controls.Buttons.CircularButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bases="clr-namespace:SLO.MobileApp.Controls.Bases"
    xmlns:templatedViews="clr-namespace:SLO.MobileApp.Controls.TemplatedViews">

    <templatedViews:TemplatedButtonView.ControlTemplate>
        <ControlTemplate>

            <bases:ButtonBase
                x:Name="ButtonBase"
                Background="{TemplateBinding Background}"
                BackgroundColor="{TemplateBinding ButtonColor}"
                Clicked="ButtonClicked"
                CornerRadius="{TemplateBinding Size}"
                FontAttributes="{TemplateBinding FontAttributes}"
                FontAutoScalingEnabled="True"
                FontSize="{TemplateBinding FontSize}"
                HeightRequest="{TemplateBinding ButtonDimensions}"
                Text="{TemplateBinding Text}"
                TextColor="{TemplateBinding TextColor}"
                WidthRequest="{TemplateBinding ButtonDimensions}" />

        </ControlTemplate>
    </templatedViews:TemplatedButtonView.ControlTemplate>

</templatedViews:TemplatedButtonView>
